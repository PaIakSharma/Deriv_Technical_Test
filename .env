# Copy this file to .env (or export the variables in your shell) before running.

# Required for real LLM calls. Get a key at https://openrouter.ai/.
OPENROUTER_API_KEY=

# Optional: override the default model (any OpenRouter-supported chat model).
# Defaults to anthropic/claude-3.5-sonnet.
LLM_MODEL=anthropic/claude-3.5-sonnet

# Set to 1 to force the deterministic mock LLM (useful for offline runs / CI).
# If OPENROUTER_API_KEY is missing the pipeline auto-falls-back to mock mode anyway.
USE_MOCK_LLM=0
